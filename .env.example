# App
APP_NAME=

# Database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudflare R2 (이미지 스토리지)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=   # 예: https://pub-xxxx.r2.dev 또는 커스텀 도메인

# Frontend
FRONTEND_URL=             # CORS 허용 출처, OAuth2 리다이렉트 — Docker 내부 프론트 주소 가능
SITE_URL=                 # 이메일 링크 전용 공개 도메인 — 반드시 외부에서 접근 가능한 실제 도메인

# 내부 서비스 통신
INTERNAL_API_KEY=         # Next.js 서버 → Java 백엔드 내부 호출용 공유 시크릿 (임의의 긴 문자열)
BACKEND_INTERNAL_URL=     # 예: http://localhost:8080 (Next.js 서버에서 백엔드로 직접 통신할 주소)
